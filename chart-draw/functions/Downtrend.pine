// ── 하락추세 판단 함수 (선형회귀 기울기 + 가격비교) ──
f_isDowntrend(src, length) =>
    regSlope = ta.linreg(src, length, 0) - ta.linreg(src, length, 1)
    src < src[length] and regSlope < 0

// 사용 예시
isDowntrend20 = f_isDowntrend(close, 20)   // 20일 하락추세 판단
isDowntrend60 = f_isDowntrend(close, 60)   // 60일 하락추세 판단

bgcolor(isDowntrend20 ? color.new(color.purple, 90) : na, title="20-day Downtrend")

// 기존 역배열 신호 스크립트에 통합하는 예시
f_isDowntrend(src, length) =>
    regSlope = ta.linreg(src, length, 0) - ta.linreg(src, length, 1)
    src < src[length] and regSlope < 0

// 기존 코드 중간에서 바로 사용
isDowntrend20 = f_isDowntrend(close, 20)

signalCond = isBullish and touchBoth and isReverseAlign and isDowntrend20  // 20일 하락추세였던 반등만 필터링
