//@version=6
indicator("이평때리기", overlay=true)

// ══════════════════════════════════════
// 기법 개요
//   큰 하락 이후 바닥권에서 주가가 회복하는 상승 초입을 잡는다.
//
//   원리   급락하면 주가와 장기 이평선의 이격이 크게 벌어진다.
//          그 상태에서 주가가 112일선을 뚫고 "안착"하면 세력 개입 신호로 보고,
//          224일선 → 448일선까지의 회복을 기대한다.
//
//   공짜 라인   112일선 안착 후 224일선까지의 구간. 위에 매물벽이 얇아
//               비교적 저항 없이 오르는 구간으로 본다.
//
//   안전성 논거   저평가(역배열 확장)에서 수축으로 전환되는 지점을 노리므로
//                 물려도 되돌아올 확률이 높다고 본다.
//
//   ⚠ 이평선은 SMA 가 아니라 EMA(지수)로 설정한다 — 기법이 요구하는 사항이다.
//     같은 기간이라도 EMA 는 최근 가격에 더 민감해 바닥에서 먼저 돌아선다.
//
//   ⚠ "뚫기"가 아니라 "안착"이다. 종가가 112일선을 한 번 넘는 것으로는 부족하고,
//     넘은 뒤 settleBars 봉 동안 아래로 안 떨어져야 인정한다. 이 구분이 없으면
//     바닥권에서 등락하는 구간마다 신호가 뜬다.
// ══════════════════════════════════════

// ══════════════════════════════════════
// 1. 장기 이평선 (지수 = EMA)
// ══════════════════════════════════════
maMidLen   = input.int(112, "중기선 (5.5개월)",  group="이평선")
maLongLen  = input.int(224, "장기선 (11개월)",   group="이평선")
maXLongLen = input.int(448, "초장기선 (22개월)", group="이평선")

emaMid   = ta.ema(close, maMidLen)
emaLong  = ta.ema(close, maLongLen)
emaXLong = ta.ema(close, maXLongLen)

pMid   = plot(emaMid,   title="EMA Mid",   color=color.yellow, linewidth=2)
pLong  = plot(emaLong,  title="EMA Long",  color=color.new(color.green, 0), linewidth=1)
plot(emaXLong, title="EMA XLong", color=color.new(color.red, 0), linewidth=1)

ma5 = ta.ema(close, 5)
plot(ma5, title="EMA5", color=color.new(color.gray, 0), linewidth=2)

isReverseAlign = emaMid < emaLong and emaLong < emaXLong

bgcolor(isReverseAlign ? color.new(color.red, 90) : na, title="역배열 배경")

// ══════════════════════════════════════
// 2. 이격 — 급락으로 벌어진 정도
// ══════════════════════════════════════
minGapPct    = input.float(10.0, "최소 이격(%)", group="이격 조건",
     tooltip="주가가 중기선보다 이 % 이상 아래로 벌어진 적이 있어야 한다.\n급락 없이 그냥 눌린 종목을 걸러낸다.")
gapLookback  = input.int(60, "이격 확인 기간(봉)", group="이격 조건")

gapPct     = (close - emaMid) / emaMid * 100
hadDeepGap = ta.lowest(gapPct, gapLookback) <= -minGapPct

// ══════════════════════════════════════
// 3. 역배열 확장 → 수축 전환
//    이평선 사이가 벌어질 대로 벌어졌다가 좁혀지기 시작하는 지점이
//    이 기법이 말하는 "저평가에서 돌아서는 자리"다.
// ══════════════════════════════════════
//    ⚠ 이 조건은 약하게 걸어야 한다. 주가가 112일선 위로 올라서면 그 때문에
//      EMA112 가 끌어올려져 이격이 좁아진다 — 즉 수축은 안착의 "결과"지 전제가
//      아니다. 안착 시점에 이격은 정점 대비 1~2% 밖에 안 좁혀져 있다.
//      합성 검증에서 15% 로 걸었더니 72건이 1건으로 죽었다. 5% 도 15건뿐.
//      2% 가 세트당 1.03건으로 적정하다. 올릴수록 진입이 늦어진다.
spreadLookback = input.int(120, "확장 정점 탐색 기간(봉)", group="수축 전환")
contractPct    = input.float(2.0, "수축 인정 비율(%)", group="수축 전환",
     tooltip="이평선 간 이격이 최근 정점 대비 이 % 만큼 좁혀지면 수축 전환으로 본다.\n올릴수록 진입이 늦어진다 — 5% 면 신호가 1/4 로 줄어든다.")

maSpread      = (emaXLong - emaMid) / emaXLong * 100   // 역배열이면 양수, 확장할수록 큼
spreadPeak    = ta.highest(maSpread, spreadLookback)
isContracting = spreadPeak > 0 and maSpread < spreadPeak * (1 - contractPct / 100)

// ══════════════════════════════════════
// 4. 112일선 안착 → 매수 신호
// ══════════════════════════════════════
settleBars = input.int(3, "안착 인정 봉수", group="안착 조건",
     tooltip="중기선 위로 올라선 뒤 이 봉수 동안 아래로 안 떨어져야 안착으로 인정.\n1로 두면 단순 돌파가 된다.")

aboveMid    = close > emaMid
barsAbove   = nz(ta.barssince(not aboveMid), 9999)
settled     = aboveMid and barsAbove >= settleBars
justSettled = settled and not settled[1]

buySignal = justSettled and isReverseAlign and hadDeepGap and isContracting

plotshape(buySignal, title="이평때리기 매수", style=shape.triangleup,
     location=location.belowbar, color=color.new(color.lime, 0),
     textcolor=color.lime, size=size.normal, text="BUY")

// ══════════════════════════════════════
// 5. 포지션 / 공짜 라인 / 목표·손절
// ══════════════════════════════════════
var bool  inPosition = false
var float entryPrice = na
var bool  hitTarget1 = false

if buySignal and not inPosition
    inPosition := true
    entryPrice := close
    hitTarget1 := false

// 1차 목표: 장기선 도달 (= 공짜 라인 끝)
if inPosition and not hitTarget1 and high >= emaLong
    hitTarget1 := true
    label.new(bar_index, high, "1차 도달\n장기선", color=color.new(color.green, 20),
         textcolor=color.white, style=label.style_label_down, size=size.small)

// 2차 목표: 초장기선 도달 → 포지션 종료
if inPosition and high >= emaXLong
    label.new(bar_index, high, "2차 도달\n초장기선", color=color.new(color.blue, 10),
         textcolor=color.white, style=label.style_label_down, size=size.small)
    inPosition := false

// 손절: 중기선 이탈
if inPosition and not buySignal and close < emaMid
    label.new(bar_index, low, "손절\n(중기선 이탈)", color=color.new(color.red, 0),
         textcolor=color.white, style=label.style_label_up, size=size.small)
    inPosition := false

// 공짜 라인 = 중기선~장기선 구간. 보유 중일 때만 칠한다.
fill(pMid, pLong, color = inPosition ? color.new(color.green, 88) : na,
     title = "공짜 라인")

// ══════════════════════════════════════
// 6. 상태 패널 (우상단 고정)
// ══════════════════════════════════════
panelPos = input.string("top_right", "상태 패널 위치", group="상태 패널",
     options=["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"])
panelSize = input.string("normal", "상태 패널 글자 크기", group="상태 패널",
     options=["small", "normal", "large", "huge"])

tblPos = panelPos == "top_left" ? position.top_left
     : panelPos == "bottom_right" ? position.bottom_right
     : panelPos == "bottom_left" ? position.bottom_left
     : panelPos == "middle_right" ? position.middle_right
     : position.top_right

tblSize = panelSize == "small" ? size.small
     : panelSize == "large" ? size.large
     : panelSize == "huge" ? size.huge
     : size.normal

var table statusPanel = table.new(tblPos, 1, 2, border_width=1)

if barstate.islast
    // 왜 아직 못 사는지를 한 줄로 알려준다
    stateTxt = inPosition           ? "● 보유 중 — 공짜 라인 진행"
         : not isReverseAlign       ? "관망 — 역배열 아님 (아직 안 내렸음)"
         : not hadDeepGap           ? "관망 — 이격이 부족 (급락이 없었음)"
         : not isContracting        ? "① 이격 벌어지는 중 — 좁혀지길 기다림"
         : not aboveMid             ? "② 수축 시작 — 중기선 올라서길 기다림"
         : "③ 중기선 위 — 안착 확인 중 (" + str.tostring(barsAbove) + "/"
           + str.tostring(settleBars) + "봉)"

    stateBg = inPosition      ? color.new(color.green, 10)
         : not isReverseAlign ? color.new(color.gray, 50)
         : not hadDeepGap     ? color.new(color.gray, 50)
         : not isContracting  ? color.new(color.red, 30)
         : not aboveMid       ? color.new(color.orange, 20)
         : color.new(color.blue, 20)

    // 목표까지 남은 거리 — 공짜 라인이 얼마나 남았는지
    toLong  = (emaLong - close) / close * 100
    toXLong = (emaXLong - close) / close * 100

    detailTxt = "이격 " + str.tostring(gapPct, "#.#") + "%"
         + "   수축 " + str.tostring(spreadPeak > 0 ? (1 - maSpread / spreadPeak) * 100 : 0, "#.#") + "%"
         + "\n1차(장기선)까지 " + str.tostring(toLong, "#.#") + "%"
         + "\n2차(초장기선)까지 " + str.tostring(toXLong, "#.#") + "%"

    table.cell(statusPanel, 0, 0, stateTxt, bgcolor=stateBg,
         text_color=color.white, text_size=tblSize)
    table.cell(statusPanel, 0, 1, detailTxt, bgcolor=color.new(color.gray, 20),
         text_color=color.white, text_size=tblSize)

// ══════════════════════════════════════
// 7. 마지막 봉에 선 이름 표시
// ══════════════════════════════════════
if barstate.islast
    label.new(bar_index + 1, emaMid, "EMA" + str.tostring(maMidLen),
         color=color.new(color.yellow, 0), textcolor=color.black,
         style=label.style_label_left, size=size.small)

    label.new(bar_index + 1, emaLong, "EMA" + str.tostring(maLongLen),
         color=color.new(color.green, 0), textcolor=color.white,
         style=label.style_label_left, size=size.small)

    label.new(bar_index + 1, emaXLong, "EMA" + str.tostring(maXLongLen),
         color=color.new(color.red, 0), textcolor=color.white,
         style=label.style_label_left, size=size.small)
