//@version=6
indicator("하락후지지 돌파", overlay=true)

// ── Inputs ──
// 기간은 원본 기법 그대로 112/224/448 을 쓴다. 미국주식도 동일하다.
//
// 미국 관행값(50/200)으로 바꾸지 않는 이유:
//   - 미국 50일선은 2.4개월짜리로, 이 기법이 요구하는 중기(5.5개월)의 절반도 안 된다.
//     역할상 한국 60일선(3개월)에 가깝다.
//   - 관행값이 작동하는 근거는 반사성(많이 보니까 반응한다)인 반면, 이 기법이
//     224를 쓰는 근거는 "1년치 매물대"라는 원가 논리다. 논리가 다르다.
//
// 거래일 기준으로 환산해 115/230/461 로 바꾸는 것도 하지 않는다:
//   - 연간 거래일이 미국 250~253 / 한국 246~248 로 거의 같아 보정폭이 3봉뿐인데,
//     계수 자체의 불확실성(1.008~1.028)이 그 보정폭과 맞먹는다.
//   - MA112 와 MA115 의 값 차이는 중앙값 0.19%, 역배열 판정이 뒤집히는 봉은 2.25%.
//     사실상 같은 선이다.
//   - 112/224/448 은 애초에 112 × {1,2,4} 인 어림값이라 유효숫자 3자리 환산은
//     가짜 정밀도다. 게다가 115/461 을 보는 참여자는 아무도 없어 반사성도 0이다.
maLen1      = input.int(112, "중기 이평선 (5.5개월)", group="바닥권 조건")
maLen2      = input.int(224, "장기 이평선 (11개월)", group="바닥권 조건")

pivotLeft   = input.int(5, "Hill Detection Left Bars", group="Hill Condition")
pivotRight  = input.int(5, "Hill Detection Right Bars (Confirmation Delay)", group="Hill Condition")

volLen      = input.int(20, "Volume Average Length", group="Breakout Condition")
volMult     = input.float(1.5, "Volume Spike Multiplier", group="Breakout Condition")

// ── 1. Bottom zone check (reverse alignment + price below MAs) ──
ma1 = ta.sma(close, maLen1)
ma2 = ta.sma(close, maLen2)

plot(ma1, title="MA Mid",  color=color.new(#b91e6b, 0), linewidth=2)
plot(ma2, title="MA Long", color=color.green, linewidth=1)

isBelowMA      = close < ma1 and close < ma2
isReverseAlign = ma1 < ma2
isBottomZone   = isBelowMA and isReverseAlign

// ── MA 5
ma5  = ta.sma(close, 5)
// ma448  = ta.sma(close, 448)

plot(ma5,  title="MA5",  color=color.rgb(255, 255, 255), linewidth=2)
// plot(ma448, title="MA448", color=color.new(#ff9900, 46), linewidth=1)

// ── MA5가 MA224에 근접 시 역삼각형 표시 (최초 근접 시점만) ──
ma5NearLongPct = input.float(2.0, "MA5-장기선 근접 허용범위(%)", group="근접 조건")

ma5NearLong = math.abs(ma5 - ma2) / ma2 * 100 <= ma5NearLongPct
ma5NearLongJustNow = ma5NearLong and not ma5NearLong[1]

plotshape(ma5NearLongJustNow, title="MA5-장기선 근접", style=shape.triangledown,
     location=location.top, color=color.new(color.yellow, 0), size=size.small)


// ── 2. Hill (previous swing high) tracking ──
pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)

var float hillLevel       = na
var int   hillBar         = na
var bool  hillBreakMarked = false   // 산 1개당 돌파 마커 1회만 표시

if not na(pivotHigh)
    hillLevel       := pivotHigh
    hillBar         := bar_index - pivotRight
    hillBreakMarked := false   // reset marker state for the new hill

isBullishCandle = close > open
bodySize   = close - open
rangeSize  = high - low
bodyRatio  = rangeSize > 0 ? bodySize / rangeSize : 0
isStrongBody = bodyRatio >= 0.6

breakHillHigh = not na(hillLevel) and high > hillLevel and isBullishCandle and isStrongBody and not hillBreakMarked

if breakHillHigh
    hillBreakMarked := true

plotshape(breakHillHigh, title="Hill Breakout Candle", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.green, 0), size=size.tiny)

// ── 3. Breakout (Concrete) condition: hill breakout + volume spike + in bottom zone ──
volSpike     = volume > ta.sma(volume, volLen) * volMult
crossHill    = ta.crossover(close, hillLevel)   // always called every bar
breakout     = not na(hillLevel) and crossHill
concreteCond = breakout and volSpike and isBottomZone

plotshape(concreteCond, title="Concrete", style=shape.labelup,
     location=location.belowbar, color=color.new(#8B7355, 0),
     textcolor=color.white, text="Concrete", size=size.small)

// ── 4. Support line (breakout bar's open price as horizontal support) ──
var line supportLine = na
var float supportPrice = na
var bool  supportBroken = false

if concreteCond
    if not na(supportLine)
        line.delete(supportLine)
    supportLine := line.new(bar_index, open, bar_index + 1, open,
         color=color.new(#8B7355, 0), style=line.style_dashed, width=2, extend=extend.right)
    supportPrice := open
    supportBroken := false

// ── 5. Support break warning (stop-loss alert) ──
// 돌파봉이 음봉이면 그 봉에서 바로 Loss가 뜨므로, 발생 봉 자체는 제외한다
if not na(supportPrice) and not supportBroken and not concreteCond and close < supportPrice
    supportBroken := true
    label.new(bar_index, low, "Loss", color=color.new(color.red, 0),
         textcolor=color.white, style=label.style_label_up, size=size.small)

// ── Hill marker (only shown for the hill that triggered a Concrete signal) ──
if concreteCond
    label.new(hillBar, hillLevel, "", style=label.style_circle,
         color=color.new(color.orange, 20), size=size.tiny)

bgcolor(isBottomZone ? color.new(color.blue, 80) : na, title="Bottom Zone (Reverse Align + Below MA) Background")

// ── Show each line's name as a label at the last bar ──
if barstate.islast
    label.new(bar_index + 1, ma1, "MA" + str.tostring(maLen1),
         color=color.new(#b91e6b, 0), textcolor=color.white,
         style=label.style_label_left, size=size.small)

    label.new(bar_index + 1, ma2, "MA" + str.tostring(maLen2),
         color=color.new(color.green, 0), textcolor=color.white,
         style=label.style_label_left, size=size.small)

    label.new(bar_index + 1, ma5, "MA5",
         color=color.new(color.white, 0), textcolor=color.black,
         style=label.style_label_left, size=size.small)

// ══════════════════════════════════════
// 6. 상태 패널 (우상단 고정)
//    마지막 봉에 붙는 라벨은 스크롤·확대하면 화면에서 사라진다. 테이블은 고정된다.
// ══════════════════════════════════════
panelPos = input.string("top_right", "상태 패널 위치", group="상태 패널",
     options=["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"])
panelSize = input.string("normal", "상태 패널 글자 크기", group="상태 패널",
     options=["small", "normal", "large", "huge"])

tblPos = panelPos == "top_left" ? position.top_left
     : panelPos == "bottom_right" ? position.bottom_right
     : panelPos == "bottom_left" ? position.bottom_left
     : panelPos == "middle_right" ? position.middle_right
     : position.top_right

tblSize = panelSize == "small" ? size.small
     : panelSize == "large" ? size.large
     : panelSize == "huge" ? size.huge
     : size.normal

var table statusPanel = table.new(tblPos, 1, 2, border_width=1)

holdingSupport = not na(supportPrice) and not supportBroken

if barstate.islast
    // 이 기법은 주가가 아직 장기선 아래에 있을 때만 판단한다.
    // "돌파"는 장기선 돌파가 아니라 직전 중간고점(산) 돌파를 뜻하므로,
    // 다른 스크립트(장기선 돌파)와 헷갈리지 않게 문구에 명시한다.
    longName = "MA" + str.tostring(maLen2)

    stateTxt = supportBroken   ? "✗ 지지선 깨짐 — 손절 자리"
         : holdingSupport      ? "● 산 넘음 (" + longName + "은 아직 위) — 지지선 버티는 중"
         : isBottomZone        ? "● " + longName + " 아래 바닥권 — 산 넘기를 기다리는 중"
         : not isBelowMA       ? "관망 — 주가가 이평선 위 (아직 안 내렸음)"
         : "관망 — 아직 역배열 아님"

    stateBg = supportBroken ? color.new(color.red, 0)
         : holdingSupport   ? color.new(color.green, 10)
         : isBottomZone     ? color.new(color.blue, 20)
         : color.new(color.gray, 50)

    hillTxt = na(hillLevel) ? "넘어야 할 산: 아직 없음"
         : "넘어야 할 산: " + str.tostring(hillLevel, format.mintick)
         + "  (" + str.tostring((hillLevel - close) / close * 100, "#.#") + "%)"

    supTxt = na(supportPrice) ? "지지선: 아직 없음"
         : "지지선: " + str.tostring(supportPrice, format.mintick)
         + "  (" + str.tostring((close - supportPrice) / supportPrice * 100, "#.#") + "%)"

    table.cell(statusPanel, 0, 0, stateTxt, bgcolor=stateBg,
         text_color=color.white, text_size=tblSize)

    table.cell(statusPanel, 0, 1, hillTxt + "\n" + supTxt,
         bgcolor=color.new(color.gray, 20),
         text_color=color.white, text_size=tblSize)